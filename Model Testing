WAVE_BANDS = {
    "delta_wave": (1, 4),
    "theta_wave": (4, 8),
    "alpha_wave": (8, 13),
    "beta_wave":  (13, 30)
}

def load_and_prep(path_to_data, L_FREQ=1.0, H_FREQ=40.0):
    raw_sig = mne.io.read_raw_edf(path_to_data, preload=True, verbose=False)
    raw_sig.filter(l_freq=L_FREQ, h_freq=H_FREQ, verbose=False) # Apply bandpass filter
    return raw_sig

def slice_into_segments(raw_sig, window_size_sec=1.0):
    fs = raw_sig.info['sfreq']
    samples_per_seg = int(window_size_sec * fs)
    data_array = raw_sig.get_data()
    n_ch, n_samples = data_array.shape

    N_SEGS = n_samples // samples_per_seg
    if N_SEGS == 0:
        return None # Data too short

    data_array = data_array[:, :N_SEGS * samples_per_seg]

    segs = data_array.reshape(n_ch, N_SEGS, samples_per_seg)
    segs = np.transpose(segs, (1, 0, 2))
    return segs


def calculate_band_power(segment_data, fs, band_limits):
    low_f, high_f = band_limits
    n_ch, _ = segment_data.shape
    power_values = np.zeros(n_ch)

    for ch_idx in range(n_ch):
        f, psd = welch(segment_data[ch_idx], fs, nperseg=min(256, segment_data.shape[1]))
        idx = (f >= low_f) & (f <= high_f)
        power_values[ch_idx] = np.trapz(psd[idx], f[idx]) # Integrate the PSD

    return power_values

def extract_all_features(segments, fs):
    n_segs, n_ch, _ = segments.shape
    # Setup final array X
    X_out = np.zeros((n_segs, n_ch * len(WAVE_BANDS)))

    band_list_values = list(WAVE_BANDS.values())

    for i in range(n_segs):
        segment_features = []
        for limits in band_list_values:
            bp = calculate_band_power(segments[i], fs, limits)
            segment_features.append(bp)

        X_out[i] = np.concatenate(segment_features) # Stack channel powers

    return X_out

def build_dataset(data_dir, window_sec=1.0):
    X_list = []
    y_list = []

    files = sorted(glob(os.path.join(data_dir, "*.edf")))
    print("Found", len(files), "EDF files") # Report file count

    for fpath in files:
        fname = os.path.basename(fpath)

        if "R01" in fname:
            label = 0  # Eyes open label
        elif "R02" in fname:
            label = 1  # Eyes closed label
        else:
            continue

        print("Processing", fname, "Label =", label)

        raw = load_and_prep(fpath)
        sfreq = raw.info['sfreq']

        windows = slice_into_segments(raw, window_sec)

        if windows is None:
            # Check if the file was too short after trimming.
            print("Skipping:", fname, "(too short)")
            continue

        X_feats = extract_all_features(windows, sfreq)

        y_feats = np.full(X_feats.shape[0], label) # Create label vector


        X_list.append(X_feats)
        y_list.append(y_feats)


    X = np.vstack(X_list) # Stack all features

    y = np.concatenate(y_list) # Concatenate all labels

    return X, y

X, y = build_dataset(DATA_DIR, window_sec=1.0)

